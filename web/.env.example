# Copy this file to .env.local (git-ignored) and paste your digid licence key.
# A web key is bound to the page's origin. For http://localhost:5173 (npm run dev) and
# http://localhost:4173 (npm run preview) use your product's sandbox key: local origins are
# accepted only with a sandbox key, never with a production key.
# Leave it empty to run in evaluation mode (watermarked results, never better than "review").
VITE_DIGID_LICENCE=
